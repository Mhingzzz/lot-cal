# Database Environment Variables
# Copy this to .env.local and update values as needed

# Database Configuration
DATABASE_URL="postgresql://forex_calculator_user:forex_calc_2024!@localhost:5432/forex_calculator_db"
POSTGRES_DB=forex_calculator_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_admin_password

# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-nextauth-secret-key-change-in-production

# Optional: External API Keys (for real-time exchange rates)
# EXCHANGE_RATE_API_KEY=your-api-key-here
# FIXER_API_KEY=your-fixer-api-key-here

# Development Mode
NODE_ENV=development