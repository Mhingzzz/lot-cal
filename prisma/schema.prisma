// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for optional save functionality
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?  // For credentials auth
  image     String?  // For OAuth providers
  emailVerified DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  calculations Calculation[]
  accounts Account[]
  sessions Session[]

  @@map("users")
}

// NextAuth.js Account model
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// NextAuth.js Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// NextAuth.js VerificationToken model
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// Currency pairs for forex trading
model CurrencyPair {
  id       String @id @default(cuid())
  baseCurrency  String // e.g., "EUR"
  quoteCurrency String // e.g., "USD"
  symbol   String @unique // e.g., "EURUSD"
  pipSize  Decimal @default(0.0001) // Standard pip size
  isActive Boolean @default(true)
  
  // Relations
  calculations Calculation[]
  exchangeRates ExchangeRate[]
  
  @@map("currency_pairs")
}

// Exchange rates (can be real-time or historical)
model ExchangeRate {
  id         String   @id @default(cuid())
  rate       Decimal  // Current exchange rate
  timestamp  DateTime @default(now())
  source     String?  // e.g., "manual", "api", "live"
  
  // Relations
  currencyPairId String
  currencyPair   CurrencyPair @relation(fields: [currencyPairId], references: [id])
  
  @@map("exchange_rates")
}

// Calculation results (for both anonymous and saved calculations)
model Calculation {
  id          String   @id @default(cuid())
  
  // Input parameters
  accountBalance    Decimal
  riskPercentage    Decimal  // Risk % of account balance
  entryPrice        Decimal
  stopLossPrice     Decimal
  accountCurrency   String   // e.g., "USD"
  
  // Calculated results
  riskAmount        Decimal  // Amount willing to lose
  pipValue          Decimal  // Value per pip
  lotSize           Decimal  // Calculated lot size
  pipDistance       Decimal  // Distance in pips to stop loss
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations (optional - for saved calculations)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])
  
  currencyPairId String
  currencyPair   CurrencyPair @relation(fields: [currencyPairId], references: [id])
  
  @@map("calculations")
}
